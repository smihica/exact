// The formatters in the strings table's locale (LLP 1054.000.003 D6): a
// German base (app.json) beside French, so the plan carries both tables'
// format data and every formatter reads the format slot. The harness tells
// no place, and the JS target's agent locale (en-US) finds no table, so each
// reads the base. German symbols and grouping, 24-hour times, names and
// relative words, `iso` unchanged, and "" for the invalid. The calls are
// written out: a `fn`'s body is closed in the semantics, so it cannot read
// the format slot (as it cannot read the locale slot for `t`).
component App
  state k = 1
  state z = 0
  // 2026-10-11T23:42:00Z, a Sunday.
  state now = 1791762120000
  derive decimal = `${formatNumber(1234.5 * k, "decimal")} ${formatNumber(-0.005 * k, "decimal")} ${formatNumber(999999 * k, "decimal")} ${formatNumber(1e12 * k, "decimal")}`
  derive percent = `${formatNumber(1234.5 * k, "percent")} ${formatNumber(-0.005 * k, "percent")} ${formatNumber(999999 * k, "percent")}`
  derive money = `${formatNumber(1234.5 * k, "currency", "EUR")} ${formatNumber(-0.005 * k, "currency", "EUR")} ${formatNumber(999999 * k, "currency", "JPY")} ${formatNumber(1234.5 * k, "currency", "CHF")}`
  derive compact = `${formatNumber(1234.5 * k, "compact")} ${formatNumber(-0.005 * k, "compact")} ${formatNumber(999999 * k, "compact")} ${formatNumber(1e12 * k, "compact")}`
  derive dates = `${formatDate(now, -420, "medium")} / ${formatDate(now, -420, "month-year")} / ${formatDate(now, -420, "iso")} / ${formatTime(now, -420, "short")} | ${formatDate(now - 86400000 * 40, 120, "medium")} / ${formatTime(now - 86400000 * 40, 120, "short")} | ${formatDate(-62135596800000, 0, "medium")} / ${formatDate(-62135596800000, 0, "month-year")}`
  derive days = `${formatDay(now, now, -420, "day-time")} / ${formatDay(now - 86400000, now, -420, "day")} / ${formatDay(now - 86400000, now, -420, "list")} / ${formatDay(now - 86400000 * 3, now, -420, "list")} / ${formatDay(now + 86400000, now, -420, "day-time")} / ${formatDay(now - 86400000 * 9, now, -420, "list")} / ${formatDay(now - 86400000 * 9, now, -420, "day")}`
  derive bad = `[${formatNumber(1 / z, "decimal")}${formatNumber(1 / z, "compact")}][${formatDate(now, 1081, "medium")}${formatTime(0 / 0, 0, "short")}][${formatDay(0 / 0, now, 0, "day")}]`
  derive picked = `${formatDate("2024-02-29", -1080, "medium")} / ${formatDate("2024-02-29", 1080, "month-year")} / ${formatDate("0001-01-01", -1080, "iso")} / ${formatDate("9999-12-31", 1080, "iso")}`
  derive badDay = `[${formatDate("1900-02-29", 0, "medium")}][${formatDate("2026-10-16", 1081, "month-year")}][${formatDate("2024-02-29\n", 0, "iso")}]`
  action grow
    k = k * 13
    now = now + 86400000 * 5 + 3600000 * 7
  action flip
    k = -k
  view
    column
      text t("title") testId="title"
      text decimal testId="decimal"
      text percent testId="percent"
      text money testId="money"
      text compact testId="compact"
      text dates testId="dates"
      text days testId="days"
      text bad testId="bad"
      text picked testId="picked"
      text badDay testId="badDay"
      button "grow" press=grow testId="grow"
      button "flip" press=flip testId="flip"

test "formats"
  expect text "title" == "Formate"
  expect text "decimal" == "1.234,5 -0,005 999.999 1.000.000.000.000"
  expect text "percent" == "123.450 % -1 % 99.999.900 %"
  expect text "money" == "1.234,50 € -0,01 € 999.999 ¥ 1.234,50 CHF"
  expect text "compact" == "1234 -0,005 999.999 1 Bio."
  expect text "dates" == "11.10.2026 / Oktober 2026 / 2026-10-11 / 16:42 | 02.09.2026 / 01:42 | 01.01.1 / Januar 1"
  expect text "days" == "Heute, 16:42 / Gestern / Gestern / Donnerstag / Morgen, 16:42 / 02.10.26 / 02.10.2026"
  expect text "bad" == "[][][]"
  expect text "picked" == "29.02.2024 / Februar 2024 / 0001-01-01 / 9999-12-31"
  expect text "badDay" == "[][][]"
  tap "grow"
  tap "flip"
  tap "grow"
  expect text "decimal" == "-208.630,5 0,845 -168.999.831 -169.000.000.000.000"
  expect text "compact" == "-208.630 0,84 -168 Mio. -169 Bio."
  expect text "dates" == "22.10.2026 / Oktober 2026 / 2026-10-22 / 06:42 | 12.09.2026 / 15:42 | 01.01.1 / Januar 1"
  expect text "days" == "Heute, 06:42 / Gestern / Gestern / Montag / Morgen, 06:42 / 13.10.26 / 13.10.2026"
