atom badge link="badge:"

component HeadlessMarkdown
  state icons: bool = false
  action showIcons
    icons = true
  derive symbolFaces = [AtomFace(source="[Ab](badge:done)", label="Ab", icon="symbol:sf/circle.fill", title="", color="", backgroundColor="", direction="", ariaLabel="")]
  derive imageFaces = [AtomFace(source="[Ab](badge:done)", label="Ab", icon="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 4 4%27%3E%3Cpath d=%27M0 0h4v4H0z%27 fill=%27red%27/%3E%3C/svg%3E", title="", color="", backgroundColor="", direction="", ariaLabel="")]
  derive failedFaces = [AtomFace(source="[Ab](badge:done)", label="Ab", icon="data:image/svg+xml,%3Csvg", title="", color="", backgroundColor="", direction="", ariaLabel="")]
  view
    column
      text "**expanded**" markup="markdown" testId="markdown-body"
      button "Icons" press=showIcons testId="show-icons" appearance="none"
      if icons
        text "Before [Ab](badge:done) after" markup="markdown" atoms="badge" atomFaces=symbolFaces testId="fitted-symbol" font-size=32 width=1 white-space="nowrap" -exact-fit="shrink"
        text "Before [Ab](badge:done) after" markup="markdown" atoms="badge" atomFaces=imageFaces testId="fitted-image" font-size=32 width=1 white-space="nowrap" -exact-fit="shrink"
        text "Before [Ab](badge:done) after" markup="markdown" atoms="badge" atomFaces=failedFaces testId="failed-image" font-size=32 width=1 white-space="nowrap" -exact-fit="shrink"
