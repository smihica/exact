// A partitioned iframe's window requests and downloads reaching actions, driven by IframeWindowsSessionTests (LLP 1020.002 D5).
routes pages
  home "/"

component App
  derive origin = searchParam(top(pages), "origin")
  state opened = ""
  state saved = ""
  action asked(e: FrameNewWindow)
    opened = e.disposition + " " + e.url
  action downloaded(e: FrameDownload)
    saved = e.state + " " + e.suggestedFilename
  view
    column
      iframe id="guest" src=`${origin}/opener` partition="fixture-windows" newwindow=asked download=downloaded width=300 height=180 testId="guest"
      text `${opened}|${saved}` testId="seen"
