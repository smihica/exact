// A row inserted by `if` above a sibling under a layout transition
// (LayoutInsertIOSTests). Its range has no authored height, so the host
// measures the slider after the commit's layout (#134); the sibling has a
// `z-index` and paints over the row while it slides (#135). `nudge`, above
// the insert so the insert leaves it alone, moves the slider: a batch made
// after the insert lays it out again.
component LayoutInsert
  state on = false
  state gap = 8
  action toggle
    on = not on
  action nudge
    gap = 12
  view
    column padding=24
      button press=toggle testId="toggle"
        text "Toggle"
      button press=nudge testId="nudge"
        text "Nudge"
      column testId="group" overflow="hidden" background-color="#222222" -exact-layout-transition="220ms ease-in-out"
        if on
          column testId="row" padding="12px 0px"
            text "Volume" testId="label"
            input type="range" testId="slider" value=0.3 min=0 max=1 step=0.01 width="100%" margin-top=gap
        column testId="below" padding="12px 0px" background-color="#cc2222" z-index=1 -exact-layout-transition="220ms ease-in-out"
          text "Below"
