// LLP 1123 D9 (LocalInsetsIOSTests): a route's content reads its own safe area,
// the bars included, as `var(--exact-safe-area-inset-*)`. Inside the route a
// sidebar's background reaches up under the navigation bar and its content
// starts below it, without a hard-coded bar height (expo/exact#36); the list
// beside it already clears the bar and stays. A box outside every route reads
// the session root's insets, the status bar's, which `env()` leaves at 0. A
// pushed route lets the first come back in a pop.
routes nav
  home "/"
  sheet "/sheet"
  detail "/detail"
  cover "/cover"
  coverNav "/cover-nav"

component BarInsets
  action open
    nav = push(nav, "/sheet")
  action more
    nav = push(nav, "/detail")
  action openCover
    nav = push(nav, "/cover")
  action openCoverNav
    nav = push(nav, "/cover-nav")
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` testId="route" position="absolute" inset=0 display="flex" flex-direction="column"
            header
              text "Inbox" role="heading" aria-level=1
            box position="absolute" top="var(--exact-safe-area-inset-top)" right=0 width=4 height=4 testId="absolute-probe"
            box position="absolute" bottom=0 left=0 width="var(--exact-safe-area-inset-left)" height=4 testId="left-probe"
            row flex=1 min-height=0
              column width=290 margin-top="calc(-1 * var(--exact-safe-area-inset-top))" padding-top="var(--exact-safe-area-inset-top)" background-color="-exact-system-orange" testId="sidebar"
                text "Sidebar" testId="sidebar-first"
                button press=open testId="open"
                  text "Open"
                button press=more testId="more"
                  text "More"
                button press=openCover testId="open-cover"
                  text "Cover"
                button press=openCoverNav testId="open-cover-nav"
                  text "CoverNav"
              scroll id="list" flex=1 min-height=0 testId="list"
                for i in range(30) key=i
                  text `Row ${i}` padding=12
        if e.name == "detail"
          column navigationKey=`${e.id}` testId="detail" position="absolute" inset=0
            header
              text "Detail" role="heading" aria-level=1
            box width="100%" height=40 testId="detail-fill"
            box width="var(--exact-safe-area-inset-right)" height=4 testId="detail-right-probe"
        if e.name == "sheet"
          column navigationKey=`${e.id}` navigationPresentation="modal" testId="sheet" display="flex" flex-direction="column"
            column height="var(--exact-safe-area-inset-bottom)" testId="sheet-probe"
        if e.name == "cover"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" navigationBar="none" testId="cover" position="absolute" inset=0 -exact-safe-area="none" background-color="Canvas"
            row testId="cover-bar" padding-top="var(--exact-safe-area-inset-top)" height=44 align-items="center"
              button press=back testId="close-cover"
                text "Close"
        if e.name == "coverNav"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" testId="cover-nav" position="absolute" inset=0 -exact-safe-area="none" background-color="Canvas"
            header
              text "Modal Bar" role="heading" aria-level=1
              button press=back testId="close-cover-nav"
                text "Done"
            box testId="cover-nav-probe" height="var(--exact-safe-area-inset-top)" width=4
      column position="absolute" top=0 right=0 width=4 height="var(--exact-safe-area-inset-top)" testId="root-probe"
