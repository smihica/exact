{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "[A-Za-z_](?:[A-Za-z0-9_]|-[A-Za-z])*",
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:component|shape|style|keyframes|routes|action|task|sequence|when|if|else|for|match|case|provide)\\b.*|(?:props|inject|view|theme|params|parts|perf)\\s*|members\\s+[A-Za-z_]\\w*\\s*|font\\s+\"[^\"\\\\]+\"\\s*|test\\s+\"[^\"\\\\]+\"(?:\\s+on\\s+[a-z]+(?:\\s*,\\s*[a-z]+)*)?\\s*)(?://.*)?$"
  }
}
