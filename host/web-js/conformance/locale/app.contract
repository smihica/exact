// Synthetic conformance plan: localized strings (LLP 1060) and the page's
// facts. The agent's locale is en-US, which reads the en-US table, a
// translation that lags the base (a missing key reads `en`'s). exactTime's
// resolvedLocale names that table, and formatLocale is the locale (the agent
// gives no Region of its own); exactPage and exactDelivery are answered
// by the runtime, and exactSurface with no surface publishing is its shape's
// zero record. `setLocale` chooses Arabic (its table, `rtl`, resolvedLocale)
// over the agent's locale, and `setLocale("")` hands it back; a bad tag is
// journaled and chooses nothing.
shape Time
  locale: string
  formatLocale: string
  resolvedLocale: string
shape Page
  visibilityState: string
  onLine: bool
  canShare: bool
shape Delivery
  stream: string
  seq: number
  staged: bool
  sunset: string
shape Hud
  score: number
  label: string
  tags: string[]
component Locale
  resource time = exactTime() as shape Time
  resource page = exactPage() as shape Page
  resource delivery = exactDelivery() as shape Delivery
  resource hud = exactSurface("world") as shape Hud
  state n = 2
  state greeting = t("title")
  action more
    n = n + 1
  action choose(tag: string)
    setLocale(tag)
  view
    column testId="root" padding=10
      text greeting testId="greeting"
      text t("count", n=n, who="you") testId="count"
      text t("escaped") testId="escaped"
      text `${time.locale} ${time.formatLocale} ${time.resolvedLocale}` testId="time"
      text `${page.visibilityState} ${page.onLine} ${page.canShare}` testId="page"
      text `${delivery.stream} ${delivery.seq} ${delivery.staged} [${delivery.sunset}]` testId="delivery"
      text `${hud.score} [${hud.label}] ${hud.tags.length}` testId="hud"
      button press=more testId="more"
        text t("more")
      button press=choose("ar") testId="arabic"
        text "Arabic"
      button press=choose("") testId="system"
        text "System"
      button press=choose("a b") testId="bad"
        text "Bad"
