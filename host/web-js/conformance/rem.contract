// Font-relative lengths follow root and inherited fonts on both targets.
// Controls keep their browser typography; their authored em geometry uses it.
// The app's root size overrides the drive's, refuses 0, and accepts "medium".
component Rem
  state size = 16
  state wide = false
  action pick(v: number)
    size = v
  action root(v: number)
    setRootFontSize(v)
  action medium
    setRootFontSize("medium")
  action flip
    wide = not wide
  view
    column testId="page"
      text "unsized em" testId="unsized" font-size="1.25em" margin-left="-0.5em" padding-left="1em"
      main testId="root" font-size=size padding=16
        input type="range" min=12 max=20 step=1 value=size input=pick aria-label="Font size" testId="size" width=160 height=20
        view testId="box" width="10rem" height="2rem" background-color="#dddddd"
          text "rem text" testId="label" font-size="1.5rem"
        text "em text" testId="em" font-size="1.5em" line-height="1.25em"
        view testId="pad" padding="0.5em" border-radius="0.25rem" border-width="0.125em" border-style="solid" background-color="#cccccc"
          text "padded" testId="pad-text" letter-spacing="0.1em"
        button press=flip testId="flip"
          text "flip"
        view testId="bound" width=(wide ? "12em" : "6rem") height="1em" background-color="#aaaaaa"
        row gap=8
          select testId="select-em" width="6em" padding="0.5em" value="one" aria-label="Single"
            option "One" value="one"
          select multiple=true testId="multiple-em" width="6em" padding="0.5em" value="one" aria-label="Multiple"
            option "One" value="one"
          select multiple=true testId="multiple-bound" width=(wide ? "8em" : "6em") padding=(wide ? "0.75em" : "0.5em") value="one" aria-label="Bound"
            option "One" value="one"
          select multiple=true testId="multiple-font" font-size="1.5em" width="6em" padding="0.5em" value="one" aria-label="Font"
            option "One" value="one"
        row gap=8
          button press=root(18) testId="root18"
            text "18"
          button press=root(0) testId="root0"
            text "0"
          button press=medium testId="medium"
            text "medium"
