        view testId="vflat-anon" height=50 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="view()"
      row testId="hs" width=200 height=40 flex-shrink=0 overflow-x="auto" overflow-y="hidden" scroll-padding-left=30 scroll-padding-right=10
