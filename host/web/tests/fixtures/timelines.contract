          view testId="v-exit-crossing" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="--v" animation-range="exit-crossing"
          view testId="v-mixed" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="--v" animation-range="entry 50% exit 50%"
          view testId="v-px" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="--v" animation-range="cover 50px cover 150px"
          view testId="v-anon" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="view()"
        view testId="vin" height=100 flex-shrink=0 view-timeline="--vi y 20px 10%" opacity=0.25 animation="fade 1s linear both" animation-timeline="--vi"
        view testId="vbig" height=300 flex-shrink=0 view-timeline-name="--vb"
          view testId="vb-contain" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="--vb" animation-range="contain"
          view testId="vb-entry" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="--vb" animation-range="entry"
          view testId="vb-exit" height=10 opacity=0.25 animation="fade 1s linear both" animation-timeline="--vb" animation-range="exit"
