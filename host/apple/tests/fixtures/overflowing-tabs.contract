// NavigationTabsIOSTests: horizontal padding deliberately overflows the page
// and must not feed back as a larger safe-area cover.
routes nav
  tab home "/"
  tab saved "/saved"

component OverflowingTabs
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="navigation"
      width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0
                text e.name testId=`text-${e.name}`
      row role="tablist" testId="tabs" appearance="none" flex-direction="row"
        width="100%" padding="0 4px" flex-shrink=0 z-index=1
        button role="tab" aria-controls="panel-home" aria-selected=(nav.tab == "home") press=pick("home")
          testId="tab-home" flex=1
          text "Home"
        button role="tab" aria-controls="panel-saved" aria-selected=(nav.tab == "saved") press=pick("saved")
          testId="tab-saved" flex=1
          text "Saved"
