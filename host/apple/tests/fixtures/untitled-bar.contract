// UntitledBarIOSTests (issue #364): a route's first `header` that holds a
// button and no heading is the bar with no title, the button a trailing
// item; `detail`'s header also holds a text, so it paints in the page and
// the pushed route has the system Back alone.
routes nav
  home "/"
    detail "/detail"

component UntitledBar
  state added = 0
  action add
    added = added + 1
  action open
    nav = push(nav, "/detail")
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
          if e.name == "home"
            header testId="header-home" display="flex" align-items="center" padding="8px 16px"
              view flex=1
              button press=add aria-label="Add" testId="add-home"
                image "symbol:add"
            column flex=1 padding=16
              text `added ${added}` testId="added"
              button press=open testId="open-detail"
                text "Detail"
          else
            header testId="header-detail" display="flex" align-items="center" padding="8px 16px"
              text "Draft"
              button press=add aria-label="Add" testId="add-detail"
                image "symbol:add"
            column flex=1 padding=16
              text "detail body"
