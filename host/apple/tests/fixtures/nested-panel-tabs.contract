// A tabpanel inside its root's tablist (TabStacksIOSTests): the tab bar
// takes the tabs' place, and the routes in the panel stay in the page.
component NestedPanelTabs
  state selected = "home"
  action push
    selected = "detail"
  action back
    selected = "home"
  view
    main navigationKey=selected navigationBack="back" width="100%" height="100%" display="flex" flex-direction="column"
      row role="tablist" testId="tabs" flex=1 min-height=0
        button role="tab" aria-controls="panel" aria-selected=true testId="tab-home"
          image "symbol:home"
          text "Home"
        column role="tabpanel" id="panel" flex=1 position="relative"
          column navigationKey="home" testId="route-home" position="absolute" inset=0
            header
              text "Home" role="heading" aria-level=1
            button press=push testId="push" height=44
              text "Open"
          column navigationKey="detail" testId="route-detail" position="absolute" inset=0
            header
              button id="back" press=back testId="back"
                text "Back"
              text "Detail" role="heading"
            text "Body" testId="body" height=44
