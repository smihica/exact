// A dismissed viewer and a thrown card finish 150 ms after the release, on the
// root's gated tasks. A release dismisses or throws past 120 points or 800
// points a second: a 200-point drag passes the first, and 40 points held
// 300 ms before the lift passes neither.

test "a drag down at Fit closes the viewer once the photo has left"
  tap "open-photo-00000"
  clock data
  expect tree has "viewer-handle"
  tap "viewer-handle" drag 0 200
  expect tree has "viewer-handle"
  clock +150
  clock data
  expect tree missing "viewer-handle"
  expect tree has "photos-scroll"
  expect state gallery.viewerOpen == false
  expect text "status" == "Returned to the current location of this study."

test "a short drag springs back and the viewer stays"
  tap "open-photo-00000"
  clock data
  tap "viewer-handle" drag 0 40 hold 300
  clock +1000
  clock data
  expect state dismissing == 0
  expect tree has "viewer-handle"

test "a thrown card deals the next by itself, to either side"
  expect text "deck-face" == "Card 1"
  tap "deck-handle" drag 200 0
  expect text "deck-face" == "Card 1"
  clock +150
  expect text "deck-face" == "Card 2"
  expect text "deck-next" == "Card 3"
  expect state thrown == false
  tap "deck-handle" drag -200 0
  clock +150
  expect text "deck-face" == "Card 3"

test "Deal again deals, and a throw it follows deals no second card"
  tap "deck-deal"
  expect text "deck-face" == "Card 2"
  tap "deck-handle" drag 200 0
  tap "deck-deal"
  expect text "deck-face" == "Card 3"
  clock +1000
  expect text "deck-face" == "Card 3"

test "Back after a dismiss closes once, and the next viewer stays open"
  tap "open-photo-00000"
  clock data
  tap "viewer-handle" drag 0 200
  tap "close-viewer"
  clock data
  expect tree has "photos-scroll"
  tap "open-photo-00001"
  clock data
  clock +1000
  clock data
  expect state gallery.viewerOpen == true
  expect tree has "viewer-handle"
