test "the message reader has a named Back button"
  tap "conversation-demo"
  tap "message-actions-demo-1" contextmenu
  tap "read-message"
  expect tree has "reader"
  tap "Back"
  expect tree missing "reader"
  expect tree has "composer"

test "tapbacks have names for their meanings"
  tap "conversation-demo"
  tap "message-actions-demo-1" contextmenu
  tap "Heart"
  expect state selected == ""
  clock data
  expect text "reaction-demo-1" == "❤️"
  tap "message-actions-demo-1" contextmenu
  tap "Like"
  expect state selected == ""
  clock data
  expect text "reaction-demo-1" == "👍"
  tap "message-actions-demo-1" contextmenu
  tap "Dislike"
  expect state selected == ""
  clock data
  expect text "reaction-demo-1" == "👎"
  tap "message-actions-demo-1" contextmenu
  tap "Laugh"
  expect state selected == ""
  clock data
  expect text "reaction-demo-1" == "😂"
  tap "message-actions-demo-1" contextmenu
  tap "Emphasize"
  expect state selected == ""
  clock data
  expect text "reaction-demo-1" == "‼️"
  tap "message-actions-demo-1" contextmenu
  tap "Question"
  expect state selected == ""
  clock data
  expect text "reaction-demo-1" == "❓"

test "a dismissed New Message leaves the next send in its conversation"
  tap "conversation-demo"
  tap "add"
  tap "new-ai-chat"
  tap "close-models"
  type "composer" "Still here"
  tap "send"
  clock data
  clock +500
  expect state draftThread == "demo"
  expect tree has "composer"

after "dismiss" "dismiss writes only choosing panel selected"
  only writes choosing panel selected
