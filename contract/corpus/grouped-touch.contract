// Real-touch fixture (LLP 1080.000, LLP 1084 D5): a grouped list whose rows
// UIKit draws, its authored rows hidden beneath. `tap <testId>` under
// `--touch platform` aims at the cell or accessory a finger sees: the
// switch flips `on`, the detail button and the row each count a press
// (`bun scripts/smoke-touch.mjs`). Ordinary and projected sources share a
// context menu, counting its context dispatches and selected actions.
component GroupedTouch
  state on = false
  state infos = 0
  state opens = 0
  state removes = 0
  state contexts = 0
  state choices = 0
  action context
    contexts = contexts + 1
  action choose
    choices = choices + 1
  action setOn(v: bool)
    on = v
  action info
    infos = infos + 1
  action open
    opens = opens + 1
  action remove
    removes = removes + 1
  view
    column testId="root" width="100%" height="100%"
      text `${on} ${infos} ${opens}` testId="facts" padding-top=60
      button contextmenu=context contextPopover="context-menu" testId="context-source" height=44
        text "Hold for actions"
      list appearance="auto"
        listStyle="inset-grouped"
        testId="list"
        flex=1
        min-height=0
        width="100%"
        section
          row testId="toggle-row"
            text "Read Receipts"
            input type="checkbox" switch
              checked=on
              change=setOn
              testId="toggle"
              aria-label="Read Receipts"
          row testId="info-row"
            text "Device"
            button press=info testId="info" aria-label="Info"
              image "symbol:sf/info.circle"
          button press=open contextmenu=context contextPopover="context-menu" testId="open"
            text "Open"
            image "symbol:sf/chevron.right"
          button commandfor="remove" command="show-modal" testId="delete-item"
            text "Delete item"
      dialog id="remove" role="alertdialog" aria-label="Delete item?"
        text "This item will be deleted."
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"
        button commandfor="remove" command="close" press=remove testId="remove-confirm"
          text "Delete"
      column id="context-menu" popover="auto" role="menu"
        button press=choose popovertarget="context-menu" popovertargetaction="hide" testId="context-choice"
          text "Choose action"
